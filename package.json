{
  "name": "skeinwise",
  "version": "0.1.0",
  "description": "A second brain that organises itself from your AI chats and notes. Local first, works with no AI or a small local model.",
  "license": "MIT",
  "author": "Deniz Ikili",
  "repository": "github:buzludeniz/skeinwise",
  "type": "module",
  "bin": {
    "skeinwise": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build -c web/vite.config.ts",
    "build:web": "vite build -c web/vite.config.ts",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "lucide-preact": "1.70.0",
    "preact": "11.2.0",
    "three": "0.187.0",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
