{
  "name": "skeinwise",
  "version": "0.3.0",
  "description": "A second brain that organises itself from your AI chats and notes. Local first, works with no AI or a small local model.",
  "license": "MIT",
  "author": "Deniz Ikili",
  "repository": "github:buzludeniz/skeinwise",
  "type": "module",
  "bin": {
    "skeinwise": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "dist/web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "coverage": "vitest run --coverage --testTimeout=60000",
    "bench": "node bench/run.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/src/bin.js', 0o755)\" && vite build -c web/vite.config.ts",
    "build:web": "vite build -c web/vite.config.ts",
    "prepack": "npm run clean && npm run build",
    "pack:check": "node release/pack-check.ts",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.1",
    "lucide-preact": "1.70.0",
    "preact": "11.2.0",
    "three": "0.187.0",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
